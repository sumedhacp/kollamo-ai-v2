# ==============================================================================
# Kollamo.ai — Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL / Supabase compatible)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kollamo_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Official YouTube Data API v3
# Obtain via Google Cloud Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Translation Service
# Options: nllb, marianmt, api_fallback
TRANSLATION_SERVICE=marianmt
TRANSLATION_API_KEY=optional_translation_key_if_using_api

# Machine Learning & Device Settings
# Options: cpu, cuda, mps, auto
ML_DEVICE=auto
MURIL_MODEL_PATH=google/muril-base-cased
FINETUNED_WEIGHTS_PATH=ml/models/saved_weights/muril_sentiment_v1
BATCH_SIZE=32

# Logging & Monitoring
LOG_LEVEL=INFO
